      #REMOVE_METADATA_MISSING: |
      #  max_strikes: 10
      #REMOVE_MISSING_FILES: True
      #REMOVE_ORPHANS: True
      #REMOVE_SLOW: |
      #  min_speed: 10
      #  max_strikes: 100
      #REMOVE_STALLED: |
      #  max_strikes: 10
      #REMOVE_UNMONITORED: True
      #SEARCH_UNMET_CUTOFF: |
      #  min_days_between_searches: 7
      #  max_concurrent_searches: 3
      #SEARCH_MISSING: |
      #  min_days_between_searches: 7
      #  max_concurrent_searches: 3
      #DETECT_DELETIONS: true

      # --- Instances ---
      SONARR: >
        - base_url: "http://10.1.1.190:8989"
          api_key: "$SONARR_API_KEY"

      RADARR: >
         - base_url: "http://10.1.1.190:7878"
          api_key: "$RADARR_API_KEY"

      # --- Download Clients ---
      QBITTORRENT: >
        - base_url: "http://10.1.1.190:8080"
          username: "$QBIT_USERNAME" # (optional -> if not provided, assuming not needed)
          password: "$QBIT_PASSWORD" # (optional -> if not provided, assuming not needed)
        #  name: "qBittorrent main" # (optional -> if not provided, assuming "qBittorrent". Must correspond with what is specified in your *arr as download client name)
 
    volumes:
      # - $DOCKERDIR/appdata/decluttarr/logs:/app/logs # Uncomment to get logs in text file, too      
      - ${MEDIA_SHARE:?error}/data:/data # If you use detect_deletions, add the identical mount paths that you use in your sonarr/radarr instances. This may be different to this example!
